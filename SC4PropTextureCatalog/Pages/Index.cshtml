@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";

    if (Request.QueryString.HasValue && Request.Query.ContainsKey("itemcontains")) {
        Model.SearchText = Request.Query["itemcontains"][0];
        Model.ShowThumbs = Request.Query["thumbnails"].Count != 0;
        if (Model.ShowThumbs) {
            int.TryParse(Request.Query["size"][0], out Model.ThumbSize);
        }
        Model.SetRecords();
    }
}

<div>
    <h1>Search for props, textures, buildings, or flora by Pack, TGI, Author, or Exemplar Name</h1>
    <p style="color:darkblue">Currently only thumbnails for textures are supported. Props/Buildings/Flora to follow.</p>
    <label style="color:darkblue" for="ThumbnailCoverage">Thumbnail coverage: @(Model.ThumbnailCoverage.ToString("P1"))</label>
    <progress id = "ThumbnailCoverage" max = "1" value = "@(Model.ThumbnailCoverage)"></progress>


    <form method="get" role="search">
        <input id="SearchBox" type="search" name="itemcontains" placeholder="Search for Pack | TGI | Author | Exemplar Name ..." value="@Model.SearchText">
        <select id="TGITypeSelect" aria-label="Choose TGI Type" style="width:200px">
            <option value="all" selected>All TGI Types</option>
            <option value="0">Buildings</option>
            <option value="1">Props</option>
            <option value="2">Textures</option>
            <option value="4">Flora</option>
            <option value="10">Cohorts</option>
        </select>
        <input type="Submit" value="Search" />
    </form>

    <fieldset class="grid" style="width:60%">
        <div>
            <input id="ThumbnailToggle" type="checkbox" role="switch" onclick="ShowHideSizeRange()" />
            <label for="ThumbnailToggle">Show Thumbnails</label>
        </div>
        <div id="BackgroundGroup">
            <input id="BackgroundToggle" type="checkbox" role="switch" onclick="ToggleDarkThumbnailBg()" />
            <label id="BackgroundToggleLabel" for="BackgroundToggle">Dark Background</label>
        </div>

        <select id="ThumbnailSize" aria-label="Thumbnail Size" onchange="ChangeThumbnailSize()">
            <option value="32">32 px</option>
            <option value="64" selected>64 px</option>
            <option value="96">96 px</option>
        </select>
    </fieldset>

    @{
        if (Model.SearchText is not null) {
            <p>Query "@Model.SearchText" returned @(Model.ListOfRecords.Count) results.</p>
        }
    }
    <hr />



    <table id="ContentTable">
        <thead>
            <tr class="header">
                <th>Pack Name</th>
                <th>TGI</th>
                <th>Type</th>
                <th>Author</th>
                <th>Exemplar Name</th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach (IndexModel.CatalogRecord item in Model.ListOfRecords) {
                    <tr>
                        <td><a href="#">@item.File</a></td>
                        <td>@item.TGI</td>
                        <td>@item.TGIType</td>
                        <td>@{
                                System.IO.File.Exists("~/img/thumbnails/" + item.TGI.Replace("0x", "").Replace(", ", "-") + ".png");
                                    // <img src="@(item.ImgSrc)" height="64px" loading="lazy" />
                                    
                                
                            }
                           
                        </td>
                        <td>@item.Name</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
